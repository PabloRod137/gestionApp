# ─────────────────────────────────────────────────────────────────────────────
# Nortia — plantilla de variables de entorno.
#   cp .env.example .env   y   php artisan key:generate
# Este archivo NO lleva claves ni datos reales: solo marcadores. Las claves van únicamente en el .env
# de cada máquina/servidor (el .env está ignorado por git). No cambies APP_KEY después de publicar.
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────────────────────
APP_NAME=Nortia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Intermediarios de confianza que ponen el https (proxy, túnel): direcciones separadas por comas o *. Vacío en local.
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Los seeders de ejemplo (php artisan db:seed) crean usuarios con contraseñas conocidas.
# En APP_ENV=production están bloqueados; solo se pueden permitir en una instalación de pruebas con ALLOW_SAMPLE_DATA=1.
ALLOW_SAMPLE_DATA=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de datos ────────────────────────────────────────────────────────────
# En local: SQLite (crea database/database.sqlite o apunta DB_DATABASE a un archivo .sqlite).
# En producción: MySQL.
DB_CONNECTION=sqlite
# DB_DATABASE=C:/ruta/completa/al/archivo.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nortia
# DB_USERNAME=
# DB_PASSWORD=

# Sesión, caché y colas: para trabajar en local sin MySQL, "file" y "sync" funcionan sin migraciones extra.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Correo ───────────────────────────────────────────────────────────────────
# "log" escribe los correos en storage/logs en lugar de enviarlos (válido solo para pruebas).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Web pública: datos del despacho ──────────────────────────────────────────
# Estos dos los aporta el despacho. Mientras estén vacíos o sean los de relleno, `php artisan site:readiness` bloquea publicar.
SITE_PHONE=
SITE_EMAIL=
SITE_ADDRESS="Avenida de Calvo Sotelo 24, 39002 Santander, Cantabria"
# Coordenadas del mapa de la página de contacto (ahora es el centro de Santander)
SITE_MAP_LAT=43.4623
SITE_MAP_LNG=-3.8099
SITE_HOURS="Lunes a viernes, 9:00 – 19:00"
SITE_COPYRIGHT="Nortia — Roldán Asesores"
BUSINESS_TIME_ZONE=Europe/Madrid

# Datos legales y de privacidad: los aporta el despacho. Mientras falte alguno la web NO está lista.
LEGAL_ENTITY_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_REGISTRY_DETAILS=
LEGAL_PROFESSIONAL_BODY=
LEGAL_PROFESSIONAL_NUMBER=
LEGAL_PROFESSIONAL_TITLE=
LEGAL_PROFESSIONAL_RULES=
LEGAL_TAX_PRICING_POLICY=
PRIVACY_CONTROLLER=
PRIVACY_PURPOSES_AND_BASES=
PRIVACY_RECIPIENTS=
PRIVACY_RETENTION_CRITERIA=
PRIVACY_INTERNATIONAL_TRANSFERS=
PRIVACY_RIGHTS_CONTACT=
PRIVACY_DPO_CONTACT=
PRIVACY_CONTACT_BOOKINGS=
PRIVACY_CLIENT_ACCOUNTS=

# ── Tienda y pagos (Stripe Checkout) ─────────────────────────────────────────
# Las claves van SOLO en el .env del servidor, nunca en el código ni en el chat.
# Claves de prueba (sk_test_…) fuera de producción y reales (sk_live_…) solo en producción.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Correo del despacho en Microsoft 365: crea BORRADORES, nunca envía. Ver docs/correo-microsoft-365.md ──
MS_DRAFTS_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=

# ── Puente con SharePoint (vía Power Automate). El programa no escribe en SharePoint: deja los avances para que Power Automate los refleje.
# Carpeta de salida (normalmente una carpeta de SharePoint/OneDrive sincronizada). Vacío = storage/app/sincronizacion/salida
SYNC_EXPORT_DIR=
# Exportación automática cada cinco minutos (activar cuando el flujo de Power Automate esté preparado)
SYNC_EXPORT_ENABLED=false
# "No iniciado" pasa solo a "En curso" con el primer avance; nunca se finaliza solo
SYNC_AVANCE_AUTOMATICO=true

# ── PDF de los documentos generados: se crea solo, en local ───────────────────
# auto = Microsoft Word si está instalado (mejor fidelidad) y, si no, LibreOffice. También: word | libreoffice
PDF_MOTOR=auto
# Ruta completa a soffice.exe solo si LibreOffice no está en el PATH ni en la carpeta habitual
LIBREOFFICE_PATH=

# ── IA local (Ollama): apagada por defecto. Solo bajo petición y limitada al cliente del expediente. ──
IA_ENABLED=false
IA_OLLAMA_URL=http://127.0.0.1:11434
IA_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
IA_OLLAMA_TIMEOUT=75
# Carpeta local donde están (sincronizadas) las carpetas de clientes. Opcional: la IA solo lista nombres de archivo del cliente.
IA_CARPETAS_RAIZ=

# ── Integraciones heredadas (dejar vacías si no se usan) ─────────────────────
# Power Automate -> API del programa. Token largo y aleatorio; sin él, en producción las peticiones se rechazan (503).
POWER_AUTOMATE_API_TOKEN=
POWER_AUTOMATE_CALLBACK_URL_TIMEOUT=30

# Ingesta de documentos por correo (IMAP)
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_PROTOCOL=imap
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=

# WhatsApp (webhook). El token de verificación debe ser largo y aleatorio.
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Apagado por defecto: es una integración heredada que el despacho no usa. Si se enciende hace falta WHATSAPP_APP_SECRET
# (firma de Meta) o WHATSAPP_WEBHOOK_SECRET (clave compartida); sin ninguna de las dos se rechaza todo.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_SECRET=
# Servidores desde los que se aceptan adjuntos (separados por comas; "*.dominio.com" admite subdominios)
WHATSAPP_MEDIA_HOSTS=graph.facebook.com,lookaside.fbsbx.com,*.fbcdn.net,*.whatsapp.net

# ATENCIÓN: clasificación de documentos con la API de Anthropic (nube). NO está aprobada para datos de clientes
# (la IA del despacho es local). Dejar vacía: con la clave vacía esa función no se ejecuta.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Veri*Factu (ver docs/VERIFACTU.md). Apagado: los registros se generan y quedan pendientes de envío.
VERIFACTU_ACTIVO=false
VERIFACTU_ENTORNO=pruebas
# Certificado electrónico cualificado del despacho (o de su apoderado) en PEM; solo en el .env del servidor
VERIFACTU_CERT_RUTA=
VERIFACTU_CERT_CLAVE=
VERIFACTU_CERT_KEY_RUTA=
# Productor del programa (quien firma la declaración responsable); vacío = el propio despacho (confirmar con el gestor)
VERIFACTU_PRODUCTOR_NOMBRE=
VERIFACTU_PRODUCTOR_NIF=
VERIFACTU_NUM_INSTALACION=1

# Conocimiento documental local (ver docs/INDEXACION_DOCUMENTAL.md). Apagado por defecto.
DOCUMENTAL_ACTIVO=false
# Carpeta raíz de los documentos del despacho sincronizada en este equipo (por defecto, IA_CARPETAS_RAIZ)
DOCUMENTAL_RAIZ=
# OCR local opcional (vacío = buscarlos en el PATH)
# Cola de procesado: database (con el trabajador en marcha) o sync (en el momento)
DOCUMENTAL_COLA_CONEXION=database
TESSERACT_PATH=
PDFTOPPM_PATH=
